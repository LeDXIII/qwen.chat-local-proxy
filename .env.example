# Qwen Local Proxy — configuration template.
# setup.bat copies this file to .env on first run; edit .env afterwards.
# The chat transport needs no API key: it drives your own logged-in Chrome
# session. The only optional key is DASHSCOPE_API_KEY at the bottom, and only
# for the image endpoints. Never commit a real .env — it points at your profile.

# Base URL of the Qwen web app the browser transport automates.
QWEN_BASE_URL=https://chat.qwen.ai

# Local OpenAI-compatible endpoint to bind. Keep 127.0.0.1 unless you really
# want to expose the proxy to your LAN (it has no auth).
API_HOST=127.0.0.1
API_PORT=8000

# Browser transport (Selenium + Chrome). The Qwen login lives in this Chrome
# profile — log in once in the opened window and it persists. Relative paths
# resolve against the project root, so ./browser_profile stays inside the folder.
QWEN_BROWSER_PROFILE=./browser_profile

# Absolute path to chrome.exe. Used verbatim, there is no auto-discovery: if
# Chrome is installed elsewhere, fix this line or startup fails with
# "Chrome not found at ... — set QWEN_CHROME_PATH in .env".
QWEN_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Headless works for plain chat, but the first login must be done headful, and
# some attachment dialogs behave better with a visible window.
QWEN_BROWSER_HEADLESS=false
QWEN_BROWSER_LANGUAGE=ru-RU

# Seconds to wait for a page/SPA to settle, and for a full answer to stream.
QWEN_PAGE_TIMEOUT=90
QWEN_SEND_TIMEOUT=300

# Models offered by /v1/models and the GUI dropdown before the live list is
# read from the site (comma-separated ids as they appear in the site's picker).
DEFAULT_MODELS=qwen3.7-plus,qwen3.8-max,qwen3.8-omni-flash

# Logging
LOG_LEVEL=INFO
# Set to DEBUG to see raw Qwen API requests/responses in console
DEBUG_API=false

# Version header the site itself sends on API reads; the transport copies it.
# Only bump it if the SPA starts rejecting the read requests after a site update.
SPA_HEADER_VERSION=0.3.16

# Optional: only POST /v1/images/generations and GET /v1/images/models need it
# (DashScope is a separate service, unrelated to the browser transport). Chat
# works without it. Uncomment and paste your key into .env — never into git.
# DASHSCOPE_API_KEY=
